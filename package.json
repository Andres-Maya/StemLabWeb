{
  "name": "stemlab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "description": "StemLab en el navegador: separa una canción en instrumentos con IA, edita, graba, mezcla y descarga.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.ts",
    "server": "python server/stemlab_server.py"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
